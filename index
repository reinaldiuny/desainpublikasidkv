    <script>
        // Brand Detective Logic
        function checkDetective(choice) {
            const feedbackBox = document.getElementById('detective-feedback');
            feedbackBox.classList.remove('hidden', 'bg-green-100', 'bg-red-100', 'text-green-800', 'text-red-800', 'border-green-500', 'border-red-500');
            
            if (choice === 'B') {
                feedbackBox.classList.add('bg-green-100', 'text-green-800', 'border-green-500');
                feedbackBox.innerHTML = '✅ Tepat Sekali! Identitas yang baik bukan berarti semua desain harus terlihat "kembar identik" (seperti C), juga bukan acak-acakan (seperti A). Yang dijaga konsistensinya adalah <b>Sistem Bahasa Visualnya</b> (warna, hierarki, dan elemen penanda).';
            } else if (choice === 'A') {
                feedbackBox.classList.add('bg-red-100', 'text-red-800', 'border-red-500');
                feedbackBox.innerHTML = '❌ Belum Tepat. Kumpulan desain ini (A) tidak memiliki benang merah sama sekali. Audiens tidak akan tahu bahwa ini berasal dari desainer/brand yang sama.';
            } else {
                feedbackBox.classList.add('bg-red-100', 'text-red-800', 'border-red-500');
                feedbackBox.innerHTML = '⚠️ Kurang Tepat. (C) memang konsisten, tapi jatuhnya menjadi sebuah <b>Template Kaku</b>, bukan Sistem Identitas. Desain publikasi tetap butuh fleksibilitas agar audiens tidak bosan.';
            }
        }

        // Quiz Logic
        function checkQuiz() {
            let score = 0;
            const q1 = document.querySelector('input[name="q1"]:checked');
            const q2 = document.querySelector('input[name="q2"]:checked');
            const feedbackBox = document.getElementById('quiz-feedback');
            
            if (!q1 || !q2) {
                feedbackBox.classList.remove('hidden', 'bg-green-100', 'text-green-800', 'border-green-500');
                feedbackBox.classList.add('bg-yellow-100', 'text-yellow-800', 'border-yellow-500');
                feedbackBox.innerHTML = '⚠️ Harap jawab semua pertanyaan terlebih dahulu!';
                return;
            }

            let msg1 = q1.value === 'b' ? '✅ Q1 Benar.' : '❌ Q1 Salah. (Logo hanya satu bagian kecil dari sistem identitas visual).';
            let msg2 = q2.value === 'c' ? '✅ Q2 Benar.' : '❌ Q2 Salah. (Konsistensi tidak sama dengan replikasi persis).';

            if (q1.value === 'b') score++;
            if (q2.value === 'c') score++;

            feedbackBox.classList.remove('hidden', 'bg-yellow-100', 'text-yellow-800', 'border-yellow-500', 'bg-green-100', 'text-green-800', 'border-green-500');
            
            if (score === 2) {
                feedbackBox.classList.add('bg-green-100', 'text-green-800', 'border-green-500');
            } else {
                feedbackBox.classList.add('bg-paper', 'text-ink', 'border-ink');
            }

            feedbackBox.innerHTML = `
                <div class="text-2xl mb-2 border-b border-current pb-2">Skor Kamu: ${score}/2</div>
                <div class="text-sm space-y-1 font-normal">
                    <p><b>Review:</b></p>
                    <p>${msg1}</p>
                    <p>${msg2}</p>
                    <p class="mt-4 font-bold">${score === 2 ? '🎉 Luar biasa! Kamu siap masuk ke Lab Studio.' : '💡 Coba pelajari ulang bagian LEARN di atas.'}</p>
                </div>
            `;
        }

        // Reflection LocalStorage Logic
        document.addEventListener('DOMContentLoaded', () => {
            const savedReflection = localStorage.getItem('dkv_brand_reflection');
            if (savedReflection) {
                document.getElementById('reflection-text').value = savedReflection;
            }
        });

        function saveReflection() {
            const text = document.getElementById('reflection-text').value;
            localStorage.setItem('dkv_brand_reflection', text);
            
            const status = document.getElementById('save-status');
            status.classList.remove('hidden');
            setTimeout(() => {
                status.classList.add('hidden');
            }, 3000);
        }

        async function generateAIVibe() {
            const keywords = document.getElementById('ai-keywords').value;
            const btn = document.getElementById('btn-generate-ai');
            const resultContainer = document.getElementById('ai-result-container');
            
            if (!keywords.trim()) {
                alert("Tuliskan minimal 1 kata kunci dulu!");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="ai-pulse">THINKING...</span>';
            resultContainer.classList.add('hidden');

            const payload = {
                contents: [{
                    parts: [{ text: `Berperan sebagai Art Director profesional. Junior desainer memberikan kata kunci untuk personal brand mereka: "${keywords}". Berikan deskripsi singkat (vibe) tentang bagaimana desain mereka seharusnya terlihat, rekomendasikan palet warna yang cocok, dan rekomendasikan pasangan Google Fonts (heading dan body). Jawab dalam Bahasa Indonesia yang kreatif dan menginspirasi.` }]
                }],
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: {
                        type: "OBJECT",
                        properties: {
                            "vibe": { "type": "STRING", "description": "Deskripsi vibe 2-3 kalimat." },
                            "colors": {
                                "type": "ARRAY",
                                "description": "3 sampai 4 warna palet.",
                                "items": {
                                    "type": "OBJECT",
                                    "properties": {
                                        "name": { "type": "STRING", "description": "Nama warna kreatif, misal 'Midnight Blue'" },
                                        "hex": { "type": "STRING", "description": "Hex code warna, misal '#1A2B3C'" }
                                    }
                                }
                            },
                            "fonts": {
                                "type": "OBJECT",
                                "properties": {
                                    "heading": { "type": "STRING", "description": "Nama Google Font untuk judul" },
                                    "body": { "type": "STRING", "description": "Nama Google Font untuk teks paragraf" }
                                }
                            }
                        }
                    }
                }
            };

            const apiKey = ""; // Canvas handles this automatically
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            try {
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                
                if (result.candidates && result.candidates[0].content.parts[0].text) {
                    const data = JSON.parse(result.candidates[0].content.parts[0].text);
                    
                    // Populate UI
                    document.getElementById('ai-vibe-text').innerText = `"${data.vibe}"`;
                    
                    const colorContainer = document.getElementById('ai-colors');
                    colorContainer.innerHTML = '';
                    data.colors.forEach(color => {
                        colorContainer.innerHTML += `
                            <div class="flex-1 flex flex-col items-center">
                                <div class="w-full h-12 brutal-border mb-1" style="background-color: ${color.hex}"></div>
                                <div class="text-[10px] font-bold text-center leading-tight uppercase">${color.name}<br><span class="text-muted font-mono">${color.hex}</span></div>
                            </div>
                        `;
                    });

                    document.getElementById('ai-font-heading').innerText = data.fonts.heading;
                    document.getElementById('ai-font-body').innerText = data.fonts.body;
                    
                    resultContainer.classList.remove('hidden');
                } else {
                    console.error("Unexpected API response structure", result);
                    alert("Maaf, AI sedang istirahat. Coba lagi nanti.");
                }
            } catch (error) {
                console.error("API Error:", error);
                alert("Gagal terhubung ke AI Art Director.");
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'GENERATE DIRECTION';
            }
        }

        async function askAICoach() {
            const reflection = document.getElementById('reflection-text').value;
            const btn = document.getElementById('btn-ai-coach');
            const feedbackContainer = document.getElementById('ai-coach-feedback');
            const feedbackText = document.getElementById('ai-coach-text');
            
            if (!reflection.trim()) {
                feedbackText.innerText = "Tulis refleksimu dulu di atas sebelum meminta feedback.";
                feedbackContainer.classList.remove('hidden');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="ai-pulse">Menganalisis...</span>';
            feedbackContainer.classList.add('hidden');

            const payload = {
                contents: [{
                    parts: [{ text: `Berperan sebagai guru desain grafis yang suportif namun kritis. Evaluasi refleksi identitas visual siswa ini: "${reflection}". Berikan feedback 2 kalimat dalam Bahasa Indonesia. Jika jawaban mereka terlalu umum (misal cuma 'karena bagus' atau 'karena unik'), minta mereka lebih spesifik menyebutkan aturan elemen desain (warna, font, bentuk, atau layout). Jika sudah spesifik, berikan pujian yang menguatkan konsep mereka.` }]
                }]
            };

            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            try {
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                
                if (result.candidates && result.candidates[0].content.parts[0].text) {
                    feedbackText.innerText = result.candidates[0].content.parts[0].text;
                    feedbackContainer.classList.remove('hidden');
                }
            } catch (error) {
                console.error("API Error:", error);
                feedbackText.innerText = "Koneksi ke AI Teacher gagal. Coba lagi.";
                feedbackContainer.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>🤖</span> Minta Feedback AI';
            }
        }
    </script>
